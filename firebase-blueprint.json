{
  "entities": {
    "Shop": {
      "title": "Shop",
      "description": "A verified local Nkomazi business selling food, iPhones, or other electronics.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID of the business owner."
        },
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80,
          "description": "Public display name of the Nkomazi shop."
        },
        "category": {
          "type": "string",
          "enum": ["food", "iphones", "electronics"],
          "description": "Primary Nkomazi Eats shop category."
        },
        "town": {
          "type": "string",
          "enum": [
            "Malalane",
            "Komatipoort",
            "Tonga",
            "Kamaqhekeza",
            "Naas",
            "Hectorspruit",
            "Schoemansdal",
            "Matsamo",
            "Buffelspruit",
            "Driekoppies",
            "Sibange",
            "Jeppes Reef"
          ],
          "description": "Town or village within Nkomazi Local Municipality."
        },
        "address": {
          "type": "string",
          "minLength": 4,
          "maxLength": 160,
          "description": "Street address or local landmark in Nkomazi."
        },
        "contactPhone": {
          "type": "string",
          "minLength": 7,
          "maxLength": 24,
          "description": "Public business contact or WhatsApp number."
        },
        "whatsappPhone": {
          "type": "string",
          "maxLength": 24,
          "description": "Optional dedicated WhatsApp order line."
        },
        "openingHours": {
          "type": "string",
          "maxLength": 60,
          "description": "Operating hours string."
        },
        "description": {
          "type": "string",
          "minLength": 10,
          "maxLength": 400,
          "description": "Short description of the shop and offerings."
        },
        "deliveryFee": {
          "type": "number",
          "description": "Local delivery fee in ZAR."
        },
        "etaMinutes": {
          "type": "string",
          "maxLength": 30,
          "description": "Estimated preparation and delivery window."
        },
        "isOpen": {
          "type": "boolean",
          "description": "Whether the shop is currently accepting orders."
        },
        "imageUrl": {
          "type": "string",
          "maxLength": 250000,
          "description": "Shop cover image path or compressed data URL."
        },
        "latitude": {
          "type": "number",
          "description": "Optional GPS latitude within Nkomazi."
        },
        "longitude": {
          "type": "number",
          "description": "Optional GPS longitude within Nkomazi."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last-updated timestamp."
        }
      },
      "required": [
        "ownerId",
        "name",
        "category",
        "town",
        "address",
        "contactPhone",
        "description",
        "deliveryFee",
        "etaMinutes",
        "isOpen",
        "imageUrl",
        "createdAt",
        "updatedAt"
      ]
    },
    "Product": {
      "title": "Product",
      "description": "A food item, iPhone, or electronics item sold by a local Nkomazi shop.",
      "type": "object",
      "properties": {
        "shopId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Parent shop document ID."
        },
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Owner UID matching the parent shop."
        },
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100,
          "description": "Product or meal title."
        },
        "category": {
          "type": "string",
          "enum": ["food", "iphones", "electronics"],
          "description": "Product category."
        },
        "price": {
          "type": "number",
          "description": "Unit price in ZAR."
        },
        "description": {
          "type": "string",
          "minLength": 4,
          "maxLength": 320,
          "description": "Short item description."
        },
        "specs": {
          "type": "string",
          "maxLength": 120,
          "description": "Optional portion size, storage capacity, or device condition."
        },
        "inStock": {
          "type": "boolean",
          "description": "Whether item is currently available."
        },
        "imageUrl": {
          "type": "string",
          "maxLength": 250000,
          "description": "Product image path or compressed data URL."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": [
        "shopId",
        "ownerId",
        "name",
        "category",
        "price",
        "description",
        "inStock",
        "imageUrl",
        "createdAt",
        "updatedAt"
      ]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Private customer or business owner account profile containing PII.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "maxLength": 160
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "role": {
          "type": "string",
          "enum": ["customer", "owner"]
        },
        "phone": {
          "type": "string",
          "maxLength": 24
        },
        "defaultTown": {
          "type": "string",
          "maxLength": 40
        },
        "defaultAddress": {
          "type": "string",
          "maxLength": 160
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "displayName", "role", "createdAt", "updatedAt"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer order placed at an Nkomazi local shop.",
      "type": "object",
      "properties": {
        "customerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "customerName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "customerEmail": {
          "type": "string",
          "minLength": 5,
          "maxLength": 160
        },
        "customerPhone": {
          "type": "string",
          "minLength": 7,
          "maxLength": 24
        },
        "deliveryTown": {
          "type": "string",
          "enum": [
            "Malalane",
            "Komatipoort",
            "Tonga",
            "Kamaqhekeza",
            "Naas",
            "Hectorspruit",
            "Schoemansdal",
            "Matsamo",
            "Buffelspruit",
            "Driekoppies",
            "Sibange",
            "Jeppes Reef"
          ]
        },
        "deliveryAddress": {
          "type": "string",
          "minLength": 4,
          "maxLength": 200
        },
        "shopId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "shopName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "shopOwnerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "items": {
          "type": "array",
          "description": "Bounded list of ordered line items (max 25)."
        },
        "subtotal": {
          "type": "number"
        },
        "deliveryFee": {
          "type": "number"
        },
        "total": {
          "type": "number"
        },
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "confirmed",
            "preparing",
            "out_for_delivery",
            "delivered",
            "cancelled"
          ]
        },
        "paymentMethod": {
          "type": "string",
          "enum": ["cash_on_delivery", "eft_on_delivery"]
        },
        "notes": {
          "type": "string",
          "maxLength": 250
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "customerId",
        "customerName",
        "customerEmail",
        "customerPhone",
        "deliveryTown",
        "deliveryAddress",
        "shopId",
        "shopName",
        "shopOwnerId",
        "items",
        "subtotal",
        "deliveryFee",
        "total",
        "status",
        "paymentMethod",
        "createdAt",
        "updatedAt"
      ]
    },
    "EmailNotification": {
      "title": "EmailNotification",
      "description": "Immutable record of an order status email notification sent to a customer.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "recipientEmail": {
          "type": "string",
          "minLength": 5,
          "maxLength": 160
        },
        "orderId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "shopName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "confirmed",
            "preparing",
            "out_for_delivery",
            "delivered",
            "cancelled"
          ]
        },
        "subject": {
          "type": "string",
          "minLength": 3,
          "maxLength": 140
        },
        "message": {
          "type": "string",
          "minLength": 5,
          "maxLength": 500
        },
        "deliveryChannel": {
          "type": "string",
          "enum": ["smtp", "resend", "in_app"]
        },
        "emailSent": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "userId",
        "recipientEmail",
        "orderId",
        "shopName",
        "status",
        "subject",
        "message",
        "deliveryChannel",
        "emailSent",
        "createdAt"
      ]
    },
    "Conversation": {
      "title": "Conversation",
      "description": "Two-way conversation thread between a customer and an Nkomazi shop owner.",
      "type": "object",
      "properties": {
        "shopId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "shopName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "shopOwnerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "customerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "customerName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "customerEmail": {
          "type": "string",
          "maxLength": 160
        },
        "lastOrderId": {
          "type": "string",
          "maxLength": 128
        },
        "lastMessage": {
          "type": "string",
          "maxLength": 240
        },
        "lastSenderRole": {
          "type": "string",
          "enum": ["customer", "owner"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "shopId",
        "shopName",
        "shopOwnerId",
        "customerId",
        "customerName",
        "lastMessage",
        "lastSenderRole",
        "createdAt",
        "updatedAt"
      ]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "Individual real-time message inside a customer-to-shop conversation.",
      "type": "object",
      "properties": {
        "conversationId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "customerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "shopOwnerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "senderId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "senderName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "senderRole": {
          "type": "string",
          "enum": ["customer", "owner"]
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 800
        },
        "orderId": {
          "type": "string",
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "conversationId",
        "customerId",
        "shopOwnerId",
        "senderId",
        "senderName",
        "senderRole",
        "text",
        "createdAt"
      ]
    }
  },
  "firestore": {
    "/shops/{shopId}": {
      "schema": { "$ref": "#/entities/Shop" },
      "description": "Local Nkomazi shops for food, iPhones, and electronics."
    },
    "/shops/{shopId}/products/{productId}": {
      "schema": { "$ref": "#/entities/Product" },
      "description": "Catalog items belonging to a specific Nkomazi shop."
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private user account profiles with isolated PII."
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "Customer orders placed with Nkomazi shops."
    },
    "/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/EmailNotification" },
      "description": "Order status email notification records for customers."
    },
    "/conversations/{conversationId}": {
      "schema": { "$ref": "#/entities/Conversation" },
      "description": "Customer-to-shop conversation threads."
    },
    "/conversations/{conversationId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/ChatMessage" },
      "description": "Real-time messages inside a customer-to-shop conversation."
    }
  }
}
